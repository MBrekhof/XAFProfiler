<?xml version="1.0" encoding="utf-8"?>
<Application>
  <Options UIType="TabbedMDI"
         FormStyle="Ribbon"
         RestoreTabbedMdiLayout="True"
         ShowTabImage="True"
	 VirtualScrollingEnabled="True">
  </Options>
  <NavigationItems NavigationStyle="Accordion" />
  <Views>
    <!-- ProfileSummary is a non-persistent [DomainComponent]. XAF Blazor would otherwise
         build a Queryable collection source for it, which queries a data store and never
         raises NonPersistentObjectSpace.ObjectsGetting (grid stays empty). Client mode is
         the only data access mode that fully supports non-persistent objects and raises
         ObjectsGetting. See https://docs.devexpress.com/eXpressAppFramework/113683 and
         https://docs.devexpress.com/eXpressAppFramework/118449 (Client mode). -->
    <ListView Id="ProfileSummary_ListView" DataAccessMode="Client" />
    <!-- The nested Queries grid on the ProfileSummary DetailView is also a non-persistent
         collection. Like the root list view, it runs in Client data access mode (the only mode
         that fully supports non-persistent objects). XAF generates this nested collection view
         with the id ProfileSummary_Queries_ListView; the mode is set explicitly here for clarity.
         (The grid is fed from the in-memory ProfileSummary.Queries collection, which
         ProfileSummaryDetailController populates on the shown object.) -->
    <ListView Id="ProfileSummary_Queries_ListView" DataAccessMode="Client" />
  </Views>
</Application>
